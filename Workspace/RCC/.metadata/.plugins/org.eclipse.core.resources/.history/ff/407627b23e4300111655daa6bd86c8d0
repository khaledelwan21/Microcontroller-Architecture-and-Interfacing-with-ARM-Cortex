#define RCC_PLLCFGR_PLLR_BIT               28
#define RCC_PLLCFGR_PLLPDIV_BIT            25
#define RCC_PLLCFGR_PLLPEN_BIT             30
#define RCC_PLLCFGR_PLLQEN_BIT             29

/**
 * @defgroup RCC_CFGR_SW_BITS System Clock Switch
 * @brief Bits used to select the system clock source in the RCC_CFGR register.
 */
#define RCC_CFGR_SW_BITS                   0
#define RCC_CFGR_SWS_BITS                  2            /* System Clock Switch Status */
#define RCC_CFGR_HPRE_BITS                 4            /* AHB Prescaler */
#define RCC_CFGR_PPRE1_BITS               10            /* APB1 Prescaler */    
#define RCC_CFGR_PPRE2_BITS               13            /* APB2 Prescaler */
#define RCC_CFGR_RTCPRE_BITS              16            /* RTC Prescaler */
#define RCC_CFGR_MCO1_BITS                22            /* Microcontroller Clock Output 1 */
#define RCC_CFGR_MCO1PRE_BITS             27            /* Microcontroller Clock Output 1 Prescaler */
#define RCC_CFGR_MCO2_BITS                31            /* Microcontroller Clock Output 2 */
#define RCC_CFGR_MCO2PRE_BITS             30            /* Microcontroller Clock Output 2 Prescaler */          


