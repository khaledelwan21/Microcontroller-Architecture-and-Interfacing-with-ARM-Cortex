{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "STM32 Debug (st-util)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",
      "gdbTarget": "localhost:4242",
      "device": "STM32F401RE",
      "interface": "swd",
      "runToEntryPoint": "main",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/GPIO.elf"
    }
  ]
}